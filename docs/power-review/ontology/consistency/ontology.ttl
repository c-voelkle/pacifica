@prefix ac: <urn:pacifica:ontology:consistency:> .
@prefix cv: <urn:pacifica:vocab:consistency:> .
@prefix pc: <urn:pacifica:ontology:review:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

ac:Profile a prov:Entity ; dct:title "Aumakua consistency review profile" ; dct:hasVersion "0.1.0" ;
    rdfs:comment "Additive review records, not world facts or contradiction inference. Reuses the compact profile's source and claim identities. No imports or rules." .
ac:Audit a rdfs:Class ; rdfs:subClassOf prov:Entity .
ac:Finding a rdfs:Class ; rdfs:subClassOf prov:Entity .
ac:CoverageRecord a rdfs:Class ; rdfs:subClassOf prov:Entity .
ac:audit a rdf:Property ; rdfs:comment "The bounded audit owning this finding or coverage record." .
ac:classification a rdf:Property ; rdfs:comment "Analyst assessment of incompatibility, separate from lifecycle and authorial status." .
ac:lifecycle a rdf:Property ; rdfs:comment "Issue disposition. Open does not mean proven contradiction." .
ac:detectionBasis a rdf:Property ; rdfs:comment "Prose-first detection, later graph suggestion, or prior-issue reconciliation; preserves review order." .
ac:passage a rdf:Property ; rdfs:comment "Located paired evidence, at least two distinct quote-bearing SourcePassages; may be within one paragraph." .
ac:quotation a rdf:Property ; rdfs:comment "Short exact quotation, checked against pinned local UTF-8 text; not a paraphrase or ellipsis substitution." .
ac:startLine a rdf:Property ; rdfs:comment "Optional one-based inclusive quote window; both line bounds must be supplied together." .
ac:endLine a rdf:Property .
ac:normalizedScope a rdf:Property ; rdfs:comment "Entity, time, jurisdiction, conditions, authorial qualification, narrative stance and quantity basis as relevant." .
ac:reasoning a rdf:Property .
ac:alternativeReading a rdf:Property ; rdfs:comment "Supported compatible readings and remaining uncertainty; no invented reconciliation." .
ac:repairOption a rdf:Property ; rdfs:comment "Unadopted proposal, not canon approval." .
ac:relatedClaim a rdf:Property ; rdfs:comment "Existing power-review Claim relevant to the issue; contextual relevance does not mean the conflicting propositions were fully extracted." .
ac:claimLinkNote a rdf:Property ; rdfs:comment "The bounded relevance of linked claims; required when links are present." .
ac:claimGap a rdf:Property ; rdfs:comment "Missing extraction or explanation of why no existing Claim represents the issue; required when no claim is linked and allowed with partial links." .
ac:previousFinding a rdf:Property ; rdfs:comment "Earlier stable finding IRI; does not require loading the earlier graph into this review." .
ac:resolutionEvidence a rdf:Property ; rdfs:comment "Evidence for a Resolved lifecycle, not an assumed off-page event." .
ac:coveredPassage a rdf:Property .
ac:readingMode a rdf:Property .
ac:mappedClaim a rdf:Property ; rdfs:comment "Reviewer-declared extraction mapping for this passage; not inferred from shared document or overlapping lines." .
ac:extractionNote a rdf:Property ; rdfs:comment "What is represented, absent or only contextual; required even where claims are mapped." .
ac:coverageNote a rdf:Property .
ac:independenceNote a rdf:Property ; rdfs:comment "Actual exposure to prior findings and ordering; recording this note cannot prove independence." .
ac:proseSnapshot a rdf:Property ; rdfs:comment "Pinned prose-first review document, frozen before graph consultation; historical reused reviews must be disclosed." .
ac:inspectedGraph a rdf:Property ; rdfs:comment "Pinned source graph actually inspected; passing no existing graph is permissible and must be explained." .

cv:Classification a skos:ConceptScheme .
cv:Contradiction a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "contradiction" .
cv:SuspectedContradiction a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "suspected contradiction" .
cv:IntegrationMismatch a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "integration mismatch" .
cv:MissingBridge a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "missing bridge" .
cv:NumericalDiscrepancy a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "numerical/model discrepancy" .
cv:Compatible a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "compatible reading" .
cv:IntentionalAmbiguity a skos:Concept ; skos:inScheme cv:Classification ; skos:prefLabel "intentional ambiguity" .
cv:Lifecycle a skos:ConceptScheme .
cv:Open a skos:Concept ; skos:inScheme cv:Lifecycle ; skos:prefLabel "open" .
cv:Retained a skos:Concept ; skos:inScheme cv:Lifecycle ; skos:prefLabel "retained" .
cv:Resolved a skos:Concept ; skos:inScheme cv:Lifecycle ; skos:prefLabel "resolved" .
cv:NotReproduced a skos:Concept ; skos:inScheme cv:Lifecycle ; skos:prefLabel "not reproduced" .
cv:OutsideScope a skos:Concept ; skos:inScheme cv:Lifecycle ; skos:prefLabel "outside scope" .
cv:DetectionBasis a skos:ConceptScheme .
cv:ProseFirst a skos:Concept ; skos:inScheme cv:DetectionBasis ; skos:prefLabel "prose first" .
cv:GraphSuggested a skos:Concept ; skos:inScheme cv:DetectionBasis ; skos:prefLabel "graph suggested" .
cv:PriorReconciliation a skos:Concept ; skos:inScheme cv:DetectionBasis ; skos:prefLabel "prior issue reconciliation" .
cv:ReadingMode a skos:ConceptScheme .
cv:DirectlyRead a skos:Concept ; skos:inScheme cv:ReadingMode ; skos:prefLabel "directly read" .
cv:SearchedOnly a skos:Concept ; skos:inScheme cv:ReadingMode ; skos:prefLabel "searched only" .
cv:NotRead a skos:Concept ; skos:inScheme cv:ReadingMode ; skos:prefLabel "not read" .
