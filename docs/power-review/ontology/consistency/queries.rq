# Suggestions are read-only SELECT rows, never asserted contradictions.
# query: candidate-relational-disagreements
PREFIX pc: <urn:pacifica:ontology:review:>
PREFIX v: <urn:pacifica:vocab:review:>
SELECT ?left ?right ?subject ?relation ?object ?case ?jurisdiction ?status ?startA ?endA ?startB ?endB WHERE {
  ?left a pc:Claim ; pc:subject ?subject ; pc:predicate ?relation ; pc:object ?object ; pc:case ?case ; pc:jurisdiction ?jurisdiction ; pc:authorialStatus ?status ; pc:valueState v:Known ; pc:truthValue ?truthA ; pc:startYear ?startA ; pc:endYear ?endA .
  ?right a pc:Claim ; pc:subject ?subject ; pc:predicate ?relation ; pc:object ?object ; pc:case ?case ; pc:jurisdiction ?jurisdiction ; pc:authorialStatus ?status ; pc:valueState v:Known ; pc:truthValue ?truthB ; pc:startYear ?startB ; pc:endYear ?endB .
  FILTER (STR(?left) < STR(?right) && ?truthA != ?truthB && ?startA <= ?endB && ?startB <= ?endA)
} ORDER BY ?left ?right

# query: candidate-quantity-differences
PREFIX pc: <urn:pacifica:ontology:review:>
PREFIX v: <urn:pacifica:vocab:review:>
SELECT ?left ?right ?subject ?relation ?case ?jurisdiction ?status ?valueA ?valueB ?unit ?accounting ?kind ?startA ?endA ?startB ?endB WHERE {
  ?left a pc:QuantityClaim ; pc:subject ?subject ; pc:predicate ?relation ; pc:case ?case ; pc:jurisdiction ?jurisdiction ; pc:authorialStatus ?status ; pc:valueState v:Known ; pc:numericValue ?valueA ; pc:unit ?unit ; pc:accountingBasis ?accounting ; pc:quantityKind ?kind ; pc:startYear ?startA ; pc:endYear ?endA .
  ?right a pc:QuantityClaim ; pc:subject ?subject ; pc:predicate ?relation ; pc:case ?case ; pc:jurisdiction ?jurisdiction ; pc:authorialStatus ?status ; pc:valueState v:Known ; pc:numericValue ?valueB ; pc:unit ?unit ; pc:accountingBasis ?accounting ; pc:quantityKind ?kind ; pc:startYear ?startB ; pc:endYear ?endB .
  FILTER (STR(?left) < STR(?right) && ?valueA != ?valueB && ?startA <= ?endB && ?startB <= ?endA)
} ORDER BY ?left ?right

# query: finding-claim-links
PREFIX ac: <urn:pacifica:ontology:consistency:>
PREFIX pc: <urn:pacifica:ontology:review:>
SELECT ?finding ?classification ?lifecycle ?origin ?passage ?locator ?claim ?linkNote ?gap WHERE {
  ?finding a ac:Finding ; ac:classification ?classification ; ac:lifecycle ?lifecycle ; ac:detectionBasis ?origin ; ac:passage ?passage .
  ?passage pc:locator ?locator .
  OPTIONAL { ?finding ac:relatedClaim ?claim ; ac:claimLinkNote ?linkNote }
  OPTIONAL { ?finding ac:claimGap ?gap }
} ORDER BY ?finding ?passage ?claim

# query: passage-coverage
PREFIX ac: <urn:pacifica:ontology:consistency:>
PREFIX pc: <urn:pacifica:ontology:review:>
SELECT ?audit ?passage ?locator ?mode ?claim ?note WHERE {
  ?coverage a ac:CoverageRecord ; ac:audit ?audit ; ac:coveredPassage ?passage ; ac:readingMode ?mode ; ac:extractionNote ?note .
  ?passage pc:locator ?locator .
  OPTIONAL { ?coverage ac:mappedClaim ?claim }
} ORDER BY ?audit ?passage ?claim

# query: read-passages-without-claim-mapping
PREFIX ac: <urn:pacifica:ontology:consistency:>
PREFIX cv: <urn:pacifica:vocab:consistency:>
PREFIX pc: <urn:pacifica:ontology:review:>
SELECT ?audit ?passage ?locator ?note WHERE {
  ?coverage a ac:CoverageRecord ; ac:audit ?audit ; ac:coveredPassage ?passage ; ac:readingMode cv:DirectlyRead ; ac:extractionNote ?note .
  ?passage pc:locator ?locator .
  FILTER NOT EXISTS { ?coverage ac:mappedClaim ?claim }
} ORDER BY ?audit ?passage
