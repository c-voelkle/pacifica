fg:J01 a pc:Judgment ;
    rdfs:label "Minimal clarification improves inspectability of collection and ownership but supplies no extra world power" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:C ;
    pc:conditional false ;
    pc:dependsOn fg:C04,
        fg:C05,
        fg:C06,
        fg:L02 ;
    pc:endpointYear 1932 ;
    pc:explanation "Minimal clarification improves inspectability of collection and ownership but supplies no extra world power." ;
    pc:sensitivity "If clarification introduces new collection machinery or powers it becomes a world-change case." ;
    pc:targetDimension v:Explanation ;
    pc:verdict v:Improves ;
    pc:verdictBasis v:ExplanatorySupport .

fg:J02 a pc:Judgment ;
    rdfs:label "Staged assay/remittance service is a conditional development priority, not an established endpoint improvement" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:S ;
    pc:conditional true ;
    pc:dependsOn fg:C31,
        fg:C32,
        fg:L09,
        fg:L30,
        fg:L31,
        fg:Q05,
        fg:Q06,
        fg:Q07 ;
    pc:endpointYear 1932 ;
    pc:explanation "Staged assay/remittance service is a conditional development priority, not an established endpoint improvement." ;
    pc:sensitivity "Capture response, commissioning, enforcement/avoidance, cost and preservation through succession could reverse the case." ;
    pc:targetDimension v:Implementation,
        v:MobilizableResources ;
    pc:verdict v:Unresolved ;
    pc:verdictBasis v:WorldPower .

fg:J03 a pc:Judgment ;
    rdfs:label "A 3% rate weakens gross receipts in the declared fixed-output control even at full collection" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:R ;
    pc:conditional false ;
    pc:dependsOn fg:L32,
        fg:Q02,
        fg:Q03,
        fg:Q04,
        fg:Q08 ;
    pc:endpointYear 1932 ;
    pc:explanation "A 3% rate weakens gross receipts in the declared fixed-output control even at full collection." ;
    pc:sensitivity "Higher output, reduced costs or different baseline capture could reverse real net results; no such response is estimated." ;
    pc:targetDimension v:GrossReceipts ;
    pc:verdict v:Weakens ;
    pc:verdictBasis v:FiscalDiagnostic .

fg:J04 a pc:Judgment ;
    rdfs:label "The 3% alternative has no established 1932 power effect; better consent or output must be shown rather than assumed" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:R ;
    pc:conditional true ;
    pc:dependsOn fg:C33,
        fg:L09,
        fg:Q04 ;
    pc:endpointYear 1932 ;
    pc:explanation "The 3% alternative has no established 1932 power effect; better consent or output must be shown rather than assumed." ;
    pc:sensitivity "A defensible behavioral gain and complete transmission path could outweigh foregone gross revenue." ;
    pc:targetDimension v:FreedomToAct,
        v:Leverage,
        v:MobilizableResources ;
    pc:verdict v:Unresolved ;
    pc:verdictBasis v:WorldPower .

fg:J05 a pc:Judgment ;
    rdfs:label "Accession/crisis clarification is recommended now because it preserves valid offices and makes instrument gaps explicit" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:AC ;
    pc:conditional false ;
    pc:dependsOn fg:C14,
        fg:C18,
        fg:L06,
        fg:L08,
        fg:L09,
        fg:L10 ;
    pc:endpointYear 1932 ;
    pc:explanation "Accession/crisis clarification is recommended now because it preserves valid offices and makes instrument gaps explicit." ;
    pc:sensitivity "A supposed clarification that creates an enforceable command bargain is substantive development." ;
    pc:targetDimension v:Explanation ;
    pc:verdict v:Improves ;
    pc:verdictBasis v:ExplanatorySupport .

fg:J06 a pc:Judgment ;
    rdfs:label "A new reciprocal coordination bargain could make crisis action dependable but might reduce discretion or provoke refusal" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:B ;
    pc:comparesCase fg:AD ;
    pc:conditional true ;
    pc:dependsOn fg:C35,
        fg:L09,
        fg:L10,
        fg:L33,
        fg:Q10 ;
    pc:endpointYear 1932 ;
    pc:explanation "A new reciprocal coordination bargain could make crisis action dependable but might reduce discretion or provoke refusal." ;
    pc:sensitivity "Estate legitimacy, Senate acceptance, investor alternatives, real cost and behavior after breach determine whether it helps." ;
    pc:targetDimension v:FreedomToAct,
        v:Implementation,
        v:Leverage ;
    pc:verdict v:Unresolved ;
    pc:verdictBasis v:WorldPower .

fg:J07 a pc:Judgment ;
    rdfs:label "Retaining baseline rather than adopting the 3% candidate preserves a larger gross fixed-output take and an authored path to bounded command; the relative net 1932 power effect is unmodeled" ;
    prov:wasDerivedFrom fg:P02,
        fg:P06,
        fg:P09,
        fg:P11,
        fg:PD ;
    pc:againstCase fg:R ;
    pc:comparesCase fg:B ;
    pc:conditional true ;
    pc:dependsOn fg:C06,
        fg:C08,
        fg:C09,
        fg:C13,
        fg:C15,
        fg:C18,
        fg:C20,
        fg:C21,
        fg:C22,
        fg:C23,
        fg:C24,
        fg:C25,
        fg:C26,
        fg:C27,
        fg:C28,
        fg:C29,
        fg:L02,
        fg:L09,
        fg:L10,
        fg:L16,
        fg:L17,
        fg:Q02,
        fg:Q03,
        fg:Q04 ;
    pc:endpointYear 1932 ;
    pc:explanation "Retaining baseline rather than adopting the 3% candidate preserves a larger gross fixed-output take and an authored path to bounded command; the relative net 1932 power effect is unmodeled." ;
    pc:sensitivity "Rate-driven output/participation gains, collection costs, estate/creditor refusal, succession breach, Japanese nonconsent or gold-support failure could reverse the preference." ;
    pc:targetDimension v:FreedomToAct,
        v:Implementation,
        v:Leverage,
        v:MobilizableResources ;
    pc:verdict v:Unresolved ;
    pc:verdictBasis v:WorldPower .

fg:L01 a pc:MechanismLink ;
    rdfs:label "Discovery to fiscal organization" ;
    prov:wasDerivedFrom fg:P01,
        fg:P02 ;
    pc:burdens "Costs and obligations stated in linked claims; no automatic net gain." ;
    pc:case fg:B ;
    pc:conditions "Applicable offices, resources and dated conditions of the linked claims." ;
    pc:explanation "Secrecy buys proposed diplomatic/administrative time; it does not show how dispersed gold is captured." ;
    pc:fromClaim fg:C01 ;
    pc:narrativeSupport v:Asserted ;
    pc:refusalTerms "Independent institutions and counterparties retain the refusal points stated in linked claims." ;
    pc:relationKind v:Enables ;
    pc:stage v:Creation ;
    pc:toClaim fg:C02 .

fg:L03 a pc:MechanismLink ;
